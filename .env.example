# Copy to .env (Docker) or .env.local (running directly) and fill in.
# Never commit the filled-in copy — .gitignore already excludes it.
#
# Only needed for SERVER mode. The desktop and browser storage modes need no
# configuration at all.

# --- Database -----------------------------------------------------------

# With docker compose, set a password and the URL is assembled for you.
POSTGRES_PASSWORD=choose-a-strong-password
# POSTGRES_USER=medialog
# POSTGRES_DB=medialog

# Running without Docker, point this at any Postgres instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/medialog
# TLS is used automatically for non-local hosts, or add ?sslmode=require.

# --- Auth ---------------------------------------------------------------

# The single shared password for the login prompt. There are no user accounts:
# anyone with this password sees everything. See the README before exposing
# this to the internet.
SITE_PASSWORD=choose-a-strong-password

# Signing secrets. Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Optional ------------------------------------------------------------

# Port on the host. Default 3000.
# APP_PORT=3000

# Domain for the optional Caddy HTTPS service in docker-compose.yml.
# DOMAIN=medialog.example.com

# Cover art lookup. Every provider is optional — without a key that media type
# simply returns no covers.
# Movies and TV — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Games — https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Comics use OpenLibrary, which needs no key.
