# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (pooled endpoint)
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Password for the single-user login prompt
SITE_PASSWORD=choose-a-strong-password

# JWT signing secrets — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cover art lookup (api/cover.ts). Optional: each provider degrades to
# --- returning no covers if its keys are absent.

# TMDB, for movie and TV posters — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# IGDB, for game covers — https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Comic covers use OpenLibrary, which needs no key.
